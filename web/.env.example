# Copy to .env.local for local development. The deployed site gets these from
# WebStack (Amplify app environment variables), so .env.local is never committed.
#
# API Gateway URL: PanchApiStack output "ApiUrl"
NEXT_PUBLIC_API_URL=
# Cognito: SSM /panch/auth/userPoolId and /panch/auth/userPoolClientId
NEXT_PUBLIC_USER_POOL_ID=
NEXT_PUBLIC_USER_POOL_CLIENT_ID=
